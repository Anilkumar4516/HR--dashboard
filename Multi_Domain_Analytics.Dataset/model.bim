                                                      {
                                                          "expression":  "COUNTROWS(\u0027Logistics_Fleet_Tracking\u0027)",
                                                          "name":  "Total Shipments"
                                                      },
                                                      {
                                                          "name":  "Logistics On-Time Rate (OTD %)",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE(CALCULATE(COUNTROWS(\u0027Logistics_Fleet_Tracking\u0027), \u0027Logistics_Fleet_Tracking\u0027[On_Time_Flag] = 1), COUNTROWS(\u0027Logistics_Fleet_Tracking\u0027), 0)"
                                                      },
                                                      {
                                                          "name":  "Avg Transit Duration (Hours)",
                                                          "formatString":  "0.0",
                                                          "expression":  "AVERAGE(\u0027Logistics_Fleet_Tracking\u0027[Transit_Duration_Hours])"
                                                      },
                                                      {
                                                          "name":  "Avg Route Efficiency %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "AVERAGE(\u0027Logistics_Fleet_Tracking\u0027[Route_Efficiency_Index_Pct]) / 100"
                                                      },
                                                      {
                                                          "name":  "Avg Freight Cost Per KM USD",
                                                          "formatString":  "\\$#,0.00",
                                                          "expression":  "DIVIDE(SUM(\u0027Logistics_Fleet_Tracking\u0027[Freight_Cost_USD]), SUM(\u0027Logistics_Fleet_Tracking\u0027[Distance_KM]), 0)"
                                                      },
                                                      {
                                                          "name":  "Total CO2 Emissions (MT)",
                                                          "formatString":  "#,0",
                                                          "expression":  "DIVIDE(SUM(\u0027Logistics_Fleet_Tracking\u0027[CO2_Emissions_KG]), 1000, 0)"
                                                      }
                                                  ],
