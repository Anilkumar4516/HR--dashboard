                                                         "name":  "EnvironmentSatisfaction",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "Gender",
                                                         "name":  "Gender",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "HourlyRate",
                                                         "name":  "HourlyRate",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "JobInvolvement",
                                                         "name":  "JobInvolvement",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "JobLevel",
                                                         "name":  "JobLevel",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "JobRole",
                                                         "name":  "JobRole",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "JobSatisfaction",
                                                         "name":  "JobSatisfaction",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "MaritalStatus",
                                                         "name":  "MaritalStatus",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "MonthlyIncome",
                                                         "name":  "MonthlyIncome",
                                                         "dataType":  "decimal",
                                                         "formatString":  "\\$#,0"
                                                     },
                                                     {
                                                         "sourceColumn":  "MonthlyRate",
                                                         "name":  "MonthlyRate",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "NumCompaniesWorked",
                                                         "name":  "NumCompaniesWorked",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "Over18",
                                                         "name":  "Over18",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "OverTime",
                                                         "name":  "OverTime",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "PercentSalaryHike",
                                                         "name":  "PercentSalaryHike",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "PerformanceRating",
                                                         "name":  "PerformanceRating",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "RelationshipSatisfaction",
                                                         "name":  "RelationshipSatisfaction",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "StandardHours",
                                                         "name":  "StandardHours",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "StockOptionLevel",
                                                         "name":  "StockOptionLevel",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "TotalWorkingYears",
                                                         "name":  "TotalWorkingYears",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "TrainingTimesLastYear",
                                                         "name":  "TrainingTimesLastYear",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "WorkLifeBalance",
                                                         "name":  "WorkLifeBalance",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "YearsAtCompany",
                                                         "name":  "YearsAtCompany",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "YearsInCurrentRole",
                                                         "name":  "YearsInCurrentRole",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "YearsSinceLastPromotion",
                                                         "name":  "YearsSinceLastPromotion",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "YearsWithCurrManager",
                                                         "name":  "YearsWithCurrManager",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "SalaryBand",
                                                         "name":  "SalaryBand",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "TenureBand",
                                                         "name":  "TenureBand",
                                                         "dataType":  "string"
                                                     }
                                                 ]
                                 },
                                 {
                                     "measures":  [
                                                      {
                                                          "expression":  "COUNTROWS(\u0027HR_Recruitment_Funnel\u0027)",
                                                          "name":  "Total Applications"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(COUNTROWS(\u0027HR_Recruitment_Funnel\u0027), \u0027HR_Recruitment_Funnel\u0027[StageReached] IN {\"2. Screened\", \"3. Interviewed\", \"4. Offer Extended\", \"5. Hired\"})",
                                                          "name":  "Screened Count"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(COUNTROWS(\u0027HR_Recruitment_Funnel\u0027), \u0027HR_Recruitment_Funnel\u0027[StageReached] IN {\"3. Interviewed\", \"4. Offer Extended\", \"5. Hired\"})",
                                                          "name":  "Interviewed Count"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(COUNTROWS(\u0027HR_Recruitment_Funnel\u0027), \u0027HR_Recruitment_Funnel\u0027[StageReached] IN {\"4. Offer Extended\", \"5. Hired\"})",
                                                          "name":  "Offers Extended Count"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(COUNTROWS(\u0027HR_Recruitment_Funnel\u0027), \u0027HR_Recruitment_Funnel\u0027[StageReached] = \"5. Hired\")",
                                                          "name":  "Total Hired"
                                                      },
                                                      {
                                                          "name":  "Screening Rate %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE([Screened Count], [Total Applications], 0)"
                                                      },
                                                      {
                                                          "name":  "Interview Conversion Rate %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE([Interviewed Count], [Screened Count], 0)"
                                                      },
                                                      {
                                                          "name":  "Offer Acceptance Rate %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE([Total Hired], [Offers Extended Count], 0)"
                                                      },
                                                      {
                                                          "name":  "Overall Funnel Conversion Rate %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE([Total Hired], [Total Applications], 0)"
                                                      },
                                                      {
                                                          "name":  "Avg Time to Hire (Days)",
                                                          "formatString":  "0.0",
                                                          "expression":  "CALCULATE(AVERAGE(\u0027HR_Recruitment_Funnel\u0027[TimeToHireDays]), \u0027HR_Recruitment_Funnel\u0027[StageStatus] = \"Hired\")"
                                                      },
                                                      {
                                                          "name":  "Cost Per Hire USD",
                                                          "formatString":  "\\$#,0",
                                                          "expression":  "DIVIDE(SUM(\u0027HR_Recruitment_Funnel\u0027[RecruitmentCostUSD]), [Total Hired], 0)"
                                                      }
                                                  ],
                                     "partitions":  [
                                                        {
                                                            "name":  "HR_Recruitment_Funnel-Partition",
                                                            "source":  {
                                                                           "expression":  [
                                                                                              "let",
                                                                                              "    Source = Csv.Document(File.Contents(\"C:\\Users\\rajuv\\OneDrive\\Desktop\\POWER BI\\01_Data\\HR_Analytics\\HR_Recruitment_Funnel.csv\"),[Delimiter=\",\", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                                                                                              "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                                                                                              "    Typed = Table.TransformColumnTypes(Promoted,{{\"CandidateID\", type text}, {\"Department\", type text}, {\"JobRole\", type text}, {\"ApplicationSource\", type text}, {\"RecruiterName\", type text}, {\"ApplicationDate\", type date}, {\"StageReached\", type text}, {\"StageStatus\", type text}, {\"TimeToHireDays\", Int64.Type}, {\"RecruitmentCostUSD\", Currency.Type}})",
                                                                                              "in",
                                                                                              "    Typed"
                                                                                          ],
                                                                           "type":  "m"
                                                                       },
                                                            "mode":  "import"
                                                        }
                                                    ],
                                     "name":  "HR_Recruitment_Funnel",
                                     "columns":  [
                                                     {
                                                         "sourceColumn":  "CandidateID",
                                                         "name":  "CandidateID",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "CandidateName",
                                                         "name":  "CandidateName",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "RequisitionID",
                                                         "name":  "RequisitionID",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "Department",
                                                         "name":  "Department",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "JobRole",
                                                         "name":  "JobRole",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "ApplicationSource",
                                                         "name":  "ApplicationSource",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "RecruiterName",
                                                         "name":  "RecruiterName",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "ApplicationDate",
                                                         "name":  "ApplicationDate",
                                                         "dataType":  "dateTime"
                                                     },
                                                     {
                                                         "sourceColumn":  "ScreeningDate",
                                                         "name":  "ScreeningDate",
                                                         "dataType":  "dateTime"
                                                     },
                                                     {
                                                         "sourceColumn":  "InterviewDate",
                                                         "name":  "InterviewDate",
                                                         "dataType":  "dateTime"
                                                     },
                                                     {
                                                         "sourceColumn":  "OfferDate",
                                                         "name":  "OfferDate",
                                                         "dataType":  "dateTime"
                                                     },
                                                     {
                                                         "sourceColumn":  "HireDate",
                                                         "name":  "HireDate",
                                                         "dataType":  "dateTime"
                                                     },
                                                     {
                                                         "sourceColumn":  "StageReached",
                                                         "name":  "StageReached",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "StageStatus",
                                                         "name":  "StageStatus",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "TimeToOfferDays",
                                                         "name":  "TimeToOfferDays",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "TimeToHireDays",
                                                         "name":  "TimeToHireDays",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "OfferAccepted",
                                                         "name":  "OfferAccepted",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "CandidateExperienceRating",
                                                         "name":  "CandidateExperienceRating",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "RecruitmentCostUSD",
                                                         "name":  "RecruitmentCostUSD",
                                                         "dataType":  "decimal",
                                                         "formatString":  "\\$#,0"
                                                     }
                                                 ]
                                 },
                                 {
                                     "measures":  [
                                                      {
                                                          "expression":  "DISTINCTCOUNT(\u0027Inventory_Supplier_Performance\u0027[SKU_Code])",
                                                          "name":  "Total Active SKUs"
                                                      },
                                                      {
                                                          "name":  "Total Current Inventory Value USD",
                                                          "formatString":  "\\$#,0",
                                                          "expression":  "SUMX(\u0027Inventory_Supplier_Performance\u0027, \u0027Inventory_Supplier_Performance\u0027[Current_Stock_Level] * \u0027Inventory_Supplier_Performance\u0027[Unit_Cost_USD])"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(DISTINCTCOUNT(\u0027Inventory_Supplier_Performance\u0027[SKU_Code]), \u0027Inventory_Supplier_Performance\u0027[Stock_Status] = \"Critical Stockout Risk\")",
                                                          "name":  "Critical Stockout SKUs Count"
                                                      },
                                                      {
                                                          "name":  "Supplier On-Time Delivery Rate (OTD %)",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE(CALCULATE(COUNTROWS(\u0027Inventory_Supplier_Performance\u0027), \u0027Inventory_Supplier_Performance\u0027[Delivery_Delay_Days] \u003c= 0), COUNTROWS(\u0027Inventory_Supplier_Performance\u0027), 0)"
                                                      },
                                                      {
                                                          "name":  "Avg Delay for Late Orders (Days)",
                                                          "formatString":  "0.0",
                                                          "expression":  "CALCULATE(AVERAGE(\u0027Inventory_Supplier_Performance\u0027[Delivery_Delay_Days]), \u0027Inventory_Supplier_Performance\u0027[Delivery_Delay_Days] \u003e 0)"
                                                      },
                                                      {
                                                          "name":  "OTIF Rate %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE(CALCULATE(COUNTROWS(\u0027Inventory_Supplier_Performance\u0027), \u0027Inventory_Supplier_Performance\u0027[Delivery_Delay_Days] \u003c= 0, \u0027Inventory_Supplier_Performance\u0027[Received_Quantity] \u003e= \u0027Inventory_Supplier_Performance\u0027[Order_Quantity]), COUNTROWS(\u0027Inventory_Supplier_Performance\u0027), 0)"
                                                      },
                                                      {
                                                          "name":  "Total Annual Carrying Cost USD",
                                                          "formatString":  "\\$#,0",
                                                          "expression":  "SUM(\u0027Inventory_Supplier_Performance\u0027[Annual_Carrying_Cost_USD])"
                                                      }
                                                  ],
                                     "partitions":  [
                                                        {
                                                            "name":  "Inventory_Supplier_Performance-Partition",
                                                            "source":  {
                                                                           "expression":  [
                                                                                              "let",
                                                                                              "    Source = Csv.Document(File.Contents(\"C:\\Users\\rajuv\\OneDrive\\Desktop\\POWER BI\\01_Data\\Supply_Chain\\Inventory_Supplier_Performance.csv\"),[Delimiter=\",\", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                                                                                              "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                                                                                              "    Typed = Table.TransformColumnTypes(Promoted,{{\"PO_Number\", type text}, {\"SKU_Code\", type text}, {\"Product_Category\", type text}, {\"Supplier_Name\", type text}, {\"Order_Date\", type date}, {\"Delivery_Delay_Days\", Int64.Type}, {\"Stock_Status\", type text}, {\"Total_PO_Spend_USD\", Currency.Type}, {\"Current_Stock_Level\", Int64.Type}, {\"Unit_Cost_USD\", Currency.Type}})",
                                                                                              "in",
                                                                                              "    Typed"
                                                                                          ],
                                                                           "type":  "m"
                                                                       },
                                                            "mode":  "import"
                                                        }
                                                    ],
                                     "name":  "Inventory_Supplier_Performance",
                                     "columns":  [
                                                     {
                                                         "sourceColumn":  "PO_Number",
                                                         "name":  "PO_Number",
                                                         "dataType":  "string"
                                                     },
