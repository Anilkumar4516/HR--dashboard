                                                         "name":  "Defect_Quantity",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "Unit_Cost_USD",
                                                         "name":  "Unit_Cost_USD",
                                                         "dataType":  "decimal",
                                                         "formatString":  "\\$#,0.00"
                                                     },
                                                     {
                                                         "sourceColumn":  "Total_PO_Spend_USD",
                                                         "name":  "Total_PO_Spend_USD",
                                                         "dataType":  "decimal",
                                                         "formatString":  "\\$#,0"
                                                     },
                                                     {
                                                         "sourceColumn":  "Current_Stock_Level",
                                                         "name":  "Current_Stock_Level",
                                                         "dataType":  "int64"
                                                     },
                                                     {
