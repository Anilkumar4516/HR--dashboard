                                                         "name":  "Reorder_Point",
                                                         "dataType":  "int64"
                                                     },
                                                     {
                                                         "sourceColumn":  "Stock_Status",
                                                         "name":  "Stock_Status",
                                                         "dataType":  "string"
                                                     },
                                                     {
                                                         "sourceColumn":  "Annual_Carrying_Cost_USD",
                                                         "name":  "Annual_Carrying_Cost_USD",
