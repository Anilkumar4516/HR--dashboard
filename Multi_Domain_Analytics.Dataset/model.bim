{
    "name":  "Multi_Domain_Analytics",
    "model":  {
                  "tables":  [
                                 {
                                     "measures":  [
                                                      {
                                                          "expression":  "COUNTROWS(\u0027IBM_HR_Employee_Attrition\u0027)",
                                                          "name":  "Total Employees"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(COUNTROWS(\u0027IBM_HR_Employee_Attrition\u0027), \u0027IBM_HR_Employee_Attrition\u0027[Attrition] = \"No\")",
                                                          "name":  "Active Employees"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(COUNTROWS(\u0027IBM_HR_Employee_Attrition\u0027), \u0027IBM_HR_Employee_Attrition\u0027[Attrition] = \"Yes\")",
                                                          "name":  "Attrition Count"
                                                      },
                                                      {
                                                          "name":  "Attrition Rate %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "DIVIDE([Attrition Count], [Total Employees], 0)"
                                                      },
                                                      {
                                                          "name":  "Retention Rate %",
                                                          "formatString":  "0.0%",
                                                          "expression":  "1 - [Attrition Rate %]"
                                                      },
                                                      {
                                                          "name":  "Avg Tenure of Leavers",
                                                          "formatString":  "0.0",
                                                          "expression":  "CALCULATE(AVERAGE(\u0027IBM_HR_Employee_Attrition\u0027[YearsAtCompany]), \u0027IBM_HR_Employee_Attrition\u0027[Attrition] = \"Yes\")"
                                                      },
                                                      {
                                                          "name":  "Avg Monthly Income",
                                                          "formatString":  "\\$#,0",
                                                          "expression":  "AVERAGE(\u0027IBM_HR_Employee_Attrition\u0027[MonthlyIncome])"
                                                      },
                                                      {
                                                          "expression":  "CALCULATE(COUNTROWS(\u0027IBM_HR_Employee_Attrition\u0027), \u0027IBM_HR_Employee_Attrition\u0027[Attrition] = \"No\", \u0027IBM_HR_Employee_Attrition\u0027[OverTime] = \"Yes\", \u0027IBM_HR_Employee_Attrition\u0027[JobSatisfaction] \u003c= 2, \u0027IBM_HR_Employee_Attrition\u0027[YearsAtCompany] \u003c= 3)",
                                                          "name":  "High Risk Flight Count"
                                                      },
                                                      {
                                                          "name":  "Estimated Annual Cost of Attrition",
                                                          "formatString":  "\\$#,0",
                                                          "expression":  "CALCULATE(SUM(\u0027IBM_HR_Employee_Attrition\u0027[MonthlyIncome]) * 12, \u0027IBM_HR_Employee_Attrition\u0027[Attrition] = \"Yes\") * 1.5"
                                                      }
                                                  ],
                                     "partitions":  [
                                                        {
                                                            "name":  "IBM_HR_Employee_Attrition-Partition",
                                                            "source":  {
                                                                           "expression":  [
                                                                                              "let",
                                                                                              "    Source = Csv.Document(File.Contents(\"C:\\Users\\rajuv\\OneDrive\\Desktop\\POWER BI\\01_Data\\HR_Analytics\\IBM_HR_Employee_Attrition.csv\"),[Delimiter=\",\", Columns=37, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                                                                                              "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                                                                                              "    Typed = Table.TransformColumnTypes(Promoted,{{\"EmployeeNumber\", Int64.Type}, {\"Age\", Int64.Type}, {\"Attrition\", type text}, {\"Department\", type text}, {\"JobRole\", type text}, {\"MonthlyIncome\", Currency.Type}, {\"YearsAtCompany\", Int64.Type}, {\"OverTime\", type text}, {\"SalaryBand\", type text}, {\"TenureBand\", type text}})",
                                                                                              "in",
                                                                                              "    Typed"
                                                                                          ],
                                                                           "type":  "m"
                                                                       },
                                                            "mode":  "import"
                                                        }
                                                    ],
                                     "name":  "IBM_HR_Employee_Attrition",
                                     "columns":  [
                                                     {
                                                         "isHidden":  false,
                                                         "name":  "EmployeeNumber",
                                                         "dataType":  "int64",
                                                         "sourceColumn":  "EmployeeNumber"
                                                     },
                                                     {
                                                         "sourceColumn":  "Age",
                                                         "name":  "Age",
                                                         "dataType":  "int64"
                                                     },
